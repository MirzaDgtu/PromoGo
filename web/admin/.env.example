# Copy to .env.local (dev) or configure equivalently in your deployment
# platform for a pilot environment. The OIDC provider itself is deployment
# configuration (knowledge/Decisions.md DEC-004) — nothing here is a real
# provider's value.
#
# For local dev without a real IdP, run `make oidc-mock-up` (see README.md
# "Local OIDC for dev") and use:
#   VITE_OIDC_AUTHORITY=http://localhost:8091/default
#   VITE_OIDC_CLIENT_ID=promogo-admin-web
# — verified end-to-end against the real backend: login -> POST
# /api/v1/staff/auth/oidc -> GET /api/v1/staff/me.

# The OIDC issuer's base URL, e.g. https://login.example-idp.com/promogo
VITE_OIDC_AUTHORITY=

# The SPA client id registered with that issuer for PromoGo Admin Web.
# Must be a public client (Authorization Code + PKCE, no client secret in
# the browser). Also becomes the ID token's "aud" claim with the mock
# issuer above — must match deployments/.env's PROMOGO_OIDC_AUDIENCE.
VITE_OIDC_CLIENT_ID=

# Optional: override the requested scopes. Defaults to "openid profile email".
VITE_OIDC_SCOPE=
