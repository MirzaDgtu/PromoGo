# Copy to .env and fill in real values for local dev. Never commit .env.
# Read by internal/config.Load() when running `go run ./cmd/promogo`
# natively (not via docker compose — that reads deployments/.env instead,
# see deployments/.env.example).
PROMOGO_FCM_CREDENTIALS_JSON=

# Staff OIDC login (internal/auth/oidc.go) — empty disables it. To test
# against the local mock issuer (make oidc-mock-up, see
# web/admin/README.md "Local OIDC for dev"):
# PROMOGO_OIDC_ISSUER_URL=http://localhost:8091/default
# PROMOGO_OIDC_AUDIENCE=promogo-admin-web
# PROMOGO_OIDC_JWKS_URL=http://localhost:8091/default/jwks
PROMOGO_OIDC_ISSUER_URL=
PROMOGO_OIDC_AUDIENCE=
PROMOGO_OIDC_JWKS_URL=
